[
  {
    "doctype": "Custom Field",
    "name": "Location-location_type",
    "dt": "Location",
    "fieldname": "location_type",
    "label": "Location Type",
    "fieldtype": "Link",
    "options": "Location Type",
    "insert_after": "parent_location",
    "reqd": 1
  },
  {
    "doctype": "Custom Field",
    "name": "Location-location_subtype",
    "dt": "Location",
    "fieldname": "location_subtype",
    "label": "Location Subtype",
    "fieldtype": "Link",
    "options": "Location Subtype",
    "insert_after": "location_type"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-asset_type_flags_section",
    "dt": "Asset",
    "fieldname": "asset_type_flags_section",
    "label": "Asset Type Flags",
    "fieldtype": "Section Break",
    "insert_after": "asset_category",
    "collapsible": 1
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-is_networked_asset",
    "dt": "Asset",
    "fieldname": "is_networked_asset",
    "label": "Is Networked Asset",
    "fieldtype": "Check",
    "default": 0,
    "insert_after": "asset_type_flags_section",
    "help": "Enable this for assets with network connectivity (IP addresses, MAC addresses, firmware)"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-is_tracked_asset",
    "dt": "Asset",
    "fieldname": "is_tracked_asset",
    "label": "Is GPS Tracked Asset",
    "fieldtype": "Check",
    "default": 0,
    "insert_after": "is_networked_asset",
    "help": "Enable this for assets with GPS tracking capabilities"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-is_iot_device",
    "dt": "Asset",
    "fieldname": "is_iot_device",
    "label": "Is IoT Device",
    "fieldtype": "Check",
    "default": 0,
    "insert_after": "is_tracked_asset",
    "help": "Enable this for IoT devices (automatically enables networked and tracked features)"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-network_information_section",
    "dt": "Asset",
    "fieldname": "network_information_section",
    "label": "Network Information",
    "fieldtype": "Section Break",
    "insert_after": "is_iot_device",
    "collapsible": 1,
    "depends_on": "eval:doc.is_networked_asset==1 || doc.is_iot_device==1"
  },

  {
    "doctype": "Custom Field",
    "name": "Asset-firmware_version",
    "dt": "Asset",
    "fieldname": "firmware_version",
    "label": "Firmware Version",
    "fieldtype": "Data",
    "insert_after": "network_information_section",
    "depends_on": "eval:doc.is_networked_asset==1 || doc.is_iot_device==1"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-switch_port",
    "dt": "Asset",
    "fieldname": "switch_port",
    "label": "Switch Port",
    "fieldtype": "Data",
    "insert_after": "firmware_version",
    "depends_on": "eval:doc.is_networked_asset==1 || doc.is_iot_device==1"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-location_installation_section",
    "dt": "Asset",
    "fieldname": "location_installation_section",
    "label": "Location & Installation",
    "fieldtype": "Section Break",
    "insert_after": "switch_port",
    "collapsible": 1
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-installation_point",
    "dt": "Asset",
    "fieldname": "installation_point",
    "label": "Installation Point",
    "fieldtype": "Data",
    "insert_after": "location_installation_section",
    "help": "e.g., Server Room A, Rack 5, U12-U14"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-asset_location",
    "dt": "Asset",
    "fieldname": "asset_location",
    "label": "Location",
    "fieldtype": "Link",
    "options": "Location",
    "insert_after": "installation_point"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-gps_coordinates_section",
    "dt": "Asset",
    "fieldname": "gps_coordinates_section",
    "label": "GPS Coordinates",
    "fieldtype": "Section Break",
    "insert_after": "asset_location",
    "collapsible": 1,
    "depends_on": "eval:doc.is_tracked_asset==1 || doc.is_iot_device==1"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-latitude",
    "dt": "Asset",
    "fieldname": "latitude",
    "label": "Latitude",
    "fieldtype": "Float",
    "precision": 8,
    "insert_after": "gps_coordinates_section",
    "help": "Range: -90 to 90",
    "depends_on": "eval:doc.is_tracked_asset==1 || doc.is_iot_device==1"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-longitude",
    "dt": "Asset",
    "fieldname": "longitude",
    "label": "Longitude",
    "fieldtype": "Float",
    "precision": 8,
    "insert_after": "latitude",
    "help": "Range: -180 to 180",
    "depends_on": "eval:doc.is_tracked_asset==1 || doc.is_iot_device==1"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-altitude",
    "dt": "Asset",
    "fieldname": "altitude",
    "label": "Altitude",
    "fieldtype": "Float",
    "insert_after": "longitude",
    "help": "Optional - in meters",
    "depends_on": "eval:doc.is_tracked_asset==1 || doc.is_iot_device==1"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-system_relationships_section",
    "dt": "Asset",
    "fieldname": "system_relationships_section",
    "label": "System Relationships",
    "fieldtype": "Section Break",
    "insert_after": "altitude",
    "collapsible": 1
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-parent_system",
    "dt": "Asset",
    "fieldname": "parent_system",
    "label": "Parent System",
    "fieldtype": "Link",
    "options": "Asset",
    "insert_after": "system_relationships_section",
    "help": "Link to parent asset (e.g., server blade to chassis)"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-components_section",
    "dt": "Asset",
    "fieldname": "components_section",
    "label": "Components",
    "fieldtype": "Section Break",
    "insert_after": "parent_system",
    "collapsible": 1
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-asset_components",
    "dt": "Asset",
    "fieldname": "asset_components",
    "label": "Asset Components",
    "fieldtype": "Table",
    "options": "Asset Component",
    "insert_after": "components_section"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-iot_section",
    "dt": "Asset",
    "fieldname": "iot_section",
    "label": "IoT Device Configuration",
    "fieldtype": "Section Break",
    "insert_after": "asset_components",
    "collapsible": 1,
    "depends_on": "eval:doc.is_iot_device==1"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-iot_device_id",
    "dt": "Asset",
    "fieldname": "iot_device_id",
    "label": "IoT Device ID",
    "fieldtype": "Data",
    "insert_after": "iot_section",
    "help": "External device identifier from IoT platform",
    "depends_on": "eval:doc.is_iot_device==1"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-iot_platform",
    "dt": "Asset",
    "fieldname": "iot_platform",
    "label": "IoT Platform",
    "fieldtype": "Select",
    "options": "Traccar\nTeltonika\nOther",
    "insert_after": "iot_device_id",
    "depends_on": "eval:doc.is_iot_device==1"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-last_communication",
    "dt": "Asset",
    "fieldname": "last_communication",
    "label": "Last Communication",
    "fieldtype": "Datetime",
    "insert_after": "iot_platform",
    "read_only": 1,
    "depends_on": "eval:doc.is_iot_device==1"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-communication_status",
    "dt": "Asset",
    "fieldname": "communication_status",
    "label": "Communication Status",
    "fieldtype": "Select",
    "options": "Online\nOffline\nUnknown",
    "default": "Unknown",
    "insert_after": "last_communication",
    "depends_on": "eval:doc.is_iot_device==1"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-device_protocol",
    "dt": "Asset",
    "fieldname": "device_protocol",
    "label": "Device Protocol",
    "fieldtype": "Data",
    "insert_after": "communication_status",
    "help": "Communication protocol used (e.g., MQTT, HTTP, TCP)",
    "depends_on": "eval:doc.is_iot_device==1"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-asset_hierarchy_section",
    "dt": "Asset",
    "fieldname": "asset_hierarchy_section",
    "label": "Asset Hierarchy",
    "fieldtype": "Section Break",
    "insert_after": "device_protocol",
    "collapsible": 1
  }
]

