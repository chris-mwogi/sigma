      "width": "50%"
    },
    {
      "fieldname": "recovery_date",
      "fieldtype": "Date",
      "label": "Recovery Date",
      "width": "50%"
    },
    {
      "fieldname": "recovered_by",
      "fieldtype": "Link",
      "label": "Recovered By",
      "options": "User",
      "width": "50%"
    },
    {
      "fieldname": "recovery_location",
      "fieldtype": "Data",
      "label": "Recovery Location",
      "width": "50%"
    },
    {
      "fieldname": "recovery_notes",
      "fieldtype": "Text Editor",
      "label": "Recovery Notes"
    },
    {
      "fieldname": "section_financial",
      "fieldtype": "Section Break",
      "label": "Financial Impact"
    },
    {
      "fieldname": "financial_loss",
      "fieldtype": "Currency",
      "label": "Financial Loss",
      "width": "50%"
    },
    {
      "fieldname": "insurance_claim_filed",
      "fieldtype": "Check",
      "label": "Insurance Claim Filed",
      "default": 0
    },
    {
      "fieldname": "insurance_claim_amount",
      "fieldtype": "Currency",
      "label": "Insurance Claim Amount",
      "width": "50%"
    },
    {
      "fieldname": "insurance_claim_status",
      "fieldtype": "Select",
      "label": "Insurance Claim Status",
      "options": "Not Filed\nPending\nApproved\nRejected\nPaid",
      "width": "50%"
    }
