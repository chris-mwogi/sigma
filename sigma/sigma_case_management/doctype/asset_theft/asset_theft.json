{
  "doctype": "DocType",
  "name": "Asset Theft",
  "module": "Sigma Case Management",
  "custom": 0,
  "is_submittable": 1,
  "autoname": "THEFT-{YYYY}-{####}",
  "title_field": "asset_description",
