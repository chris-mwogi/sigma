  "permissions": [
    {
      "role": "System Manager",
      "perm_read": 1,
      "perm_write": 1,
      "perm_create": 1,
      "perm_delete": 1,
      "perm_submit": 1
    },
    {
      "role": "Security Manager",
      "perm_read": 1,
      "perm_write": 1,
      "perm_create": 1,
      "perm_submit": 1
    },
    {
      "role": "Lead Investigator",
      "perm_read": 1,
      "perm_write": 1,
      "perm_create": 1,
      "perm_submit": 1
    },
    {
      "role": "Investigator",
      "perm_read": 1,
      "perm_write": 1,
      "perm_create": 1
    }
  ]
}

