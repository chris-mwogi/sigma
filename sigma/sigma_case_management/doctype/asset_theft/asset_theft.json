      "fieldtype": "Text Editor",
      "label": "Theft Details"
    },
    {
      "fieldname": "section_police_report",
      "fieldtype": "Section Break",
      "label": "Police Report"
    },
    {
      "fieldname": "police_report_filed",
      "fieldtype": "Check",
      "label": "Police Report Filed",
      "default": 0
    },
    {
      "fieldname": "ob_number",
      "fieldtype": "Data",
      "label": "OB Number",
      "width": "50%"
    },
    {
      "fieldname": "police_station",
      "fieldtype": "Data",
      "label": "Police Station",
      "width": "50%"
    },
    {
      "fieldname": "police_report_date",
      "fieldtype": "Date",
      "label": "Police Report Date",
      "width": "50%"
    },
    {
      "fieldname": "section_recovery",
      "fieldtype": "Section Break",
      "label": "Recovery Information"
    },
    {
      "fieldname": "recovery_status",
      "fieldtype": "Select",
      "label": "Recovery Status",
      "options": "Not Recovered\nPartially Recovered\nFully Recovered",
