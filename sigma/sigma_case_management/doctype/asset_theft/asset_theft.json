      "options": "KPLC Meter\nTransformer\nVehicle\nEquipment\nTools\nOther",
      "width": "50%"
    },
    {
      "fieldname": "asset_description",
      "fieldtype": "Data",
      "label": "Asset Description",
      "reqd": 1,
      "width": "100%"
    },
    {
      "fieldname": "section_asset_details",
      "fieldtype": "Section Break",
      "label": "Asset Details"
    },
    {
      "fieldname": "serial_number",
      "fieldtype": "Data",
      "label": "Serial Number",
      "reqd": 1,
      "width": "50%"
    },
    {
      "fieldname": "asset_owner",
      "fieldtype": "Data",
      "label": "Asset Owner",
      "width": "50%"
    },
    {
      "fieldname": "owner_contact",
      "fieldtype": "Data",
      "label": "Owner Contact",
      "width": "50%"
    },
    {
      "fieldname": "asset_value",
      "fieldtype": "Currency",
      "label": "Asset Value",
      "width": "50%"
    },
    {
      "fieldname": "currency",
      "fieldtype": "Link",
      "label": "Currency",
      "options": "Currency",
      "width": "50%"
    },
    {
      "fieldname": "section_theft_details",
      "fieldtype": "Section Break",
      "label": "Theft Details"
    },
    {
      "fieldname": "theft_location",
      "fieldtype": "Link",
      "label": "Theft Location",
      "options": "Location",
      "reqd": 1,
      "width": "50%"
    },
    {
      "fieldname": "theft_gps_coordinates",
      "fieldtype": "Data",
      "label": "Theft GPS Coordinates",
      "width": "50%"
    },
    {
      "fieldname": "theft_date",
      "fieldtype": "Date",
      "label": "Theft Date",
      "reqd": 1,
      "width": "50%"
    },
    {
      "fieldname": "discovery_date",
      "fieldtype": "Date",
      "label": "Discovery Date",
      "reqd": 1,
      "width": "50%"
