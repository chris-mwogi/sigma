{
  "doctype": "DocType",
  "name": "Case External Communication",
  "module": "Sigma Case Management",
  "custom": 0,
  "is_submittable": 0,
  "autoname": "EXTCOM-{YYYY}-{####}",
  "fields": [
    {
      "fieldname": "case",
      "fieldtype": "Link",
      "label": "Case",
      "options": "Case",
      "reqd": 1,
      "width": "50%"
    },
    {
      "fieldname": "stakeholder_type",
      "fieldtype": "Select",
      "label": "Stakeholder Type",
      "reqd": 1,
      "options": "Police\nCourt\nLegal Counsel\nInsurance Company\nClient\nEmployee\nOther",
      "width": "50%"
    },
    {
      "fieldname": "stakeholder_name",
      "fieldtype": "Data",
      "label": "Stakeholder Name",
      "reqd": 1,
      "width": "50%"
    },
    {
      "fieldname": "stakeholder_contact",
      "fieldtype": "Data",
      "label": "Contact Information",
      "width": "50%"
    },
    {
      "fieldname": "communication_type",
      "fieldtype": "Select",
      "label": "Communication Type",
      "reqd": 1,
      "options": "Email\nPhone Call\nIn-Person Meeting\nLetter\nFax\nSMS\nOther",
      "width": "50%"
    },
    {
      "fieldname": "communication_date",
      "fieldtype": "Datetime",
      "label": "Communication Date",
      "reqd": 1,
      "width": "50%"
    },
    {
      "fieldname": "subject",
      "fieldtype": "Data",
      "label": "Subject",
      "reqd": 1,
      "width": "100%"
    },
    {
      "fieldname": "message",
      "fieldtype": "Text Editor",
      "label": "Message",
      "reqd": 1
    },
    {
      "fieldname": "section_followup",
      "fieldtype": "Section Break",
      "label": "Follow-up"
    },
    {
      "fieldname": "follow_up_required",
      "fieldtype": "Check",
      "label": "Follow-up Required",
      "default": 0
    },
    {
      "fieldname": "follow_up_date",
      "fieldtype": "Date",
      "label": "Follow-up Date"
    },
    {
      "fieldname": "follow_up_action",
      "fieldtype": "Text",
      "label": "Follow-up Action"
    },
    {
      "fieldname": "section_attachments",
      "fieldtype": "Section Break",
      "label": "Attachments"
    },
    {
      "fieldname": "attachments",
      "fieldtype": "Attach",
      "label": "Attachments"
    },
    {
      "fieldname": "section_metadata",
      "fieldtype": "Section Break",
      "label": "Metadata"
    },
    {
      "fieldname": "communicated_by",
      "fieldtype": "Link",
      "label": "Communicated By",
      "options": "User",
      "read_only": 1,
      "width": "50%"
    },
    {
      "fieldname": "communication_status",
      "fieldtype": "Select",
      "label": "Communication Status",
      "options": "Sent\nReceived\nPending Response\nResolved",
      "default": "Sent",
      "width": "50%"
    },
    {
      "fieldname": "response_received",
      "fieldtype": "Check",
      "label": "Response Received",
      "default": 0
    },
    {
      "fieldname": "response_date",
      "fieldtype": "Datetime",
      "label": "Response Date"
    },
    {
      "fieldname": "response_content",
      "fieldtype": "Text Editor",
      "label": "Response Content"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "perm_read": 1,
      "perm_write": 1,
      "perm_create": 1,
      "perm_delete": 1
    },
    {
      "role": "Security Manager",
      "perm_read": 1,
      "perm_write": 1,
      "perm_create": 1
    },
    {
      "role": "Lead Investigator",
      "perm_read": 1,
      "perm_write": 1,
      "perm_create": 1
    },
    {
      "role": "Legal Officer",
      "perm_read": 1,
      "perm_write": 1,
      "perm_create": 1
    },
    {
      "role": "Investigator",
      "perm_read": 1,
      "perm_create": 1
    }
  ]
}

